[sub_resource type="GDScript" id="GDScript_a0tk4"]
script/source = "@tool
extends Node3D

@export var lebar_kotak: float = 32.0:
	set(val):
		lebar_kotak = val
		_bangun_isi_kotak()

@export var panjang_kotak: float = 18.0:
	set(val):
		panjang_kotak = val
		_bangun_isi_kotak()

func _ready() -> void:
	_bangun_isi_kotak()

func _bangun_isi_kotak() -> void:
	var wadah := get_node_or_null(\"KotakArena\") as Node3D
	if not wadah:
		wadah = Node3D.new()
		wadah.name = \"KotakArena\"
		add_child(wadah)
		if Engine.is_editor_hint():
			wadah.owner = get_tree().edited_scene_root

	for child in wadah.get_children():
		child.queue_free()

	var hx := lebar_kotak * 0.5
	var hz := panjang_kotak * 0.5

	# 1. Lantai di dalam kotak
	var papan := MeshInstance3D.new()
	papan.name = \"PapanDalamKotak\"
	var box := BoxMesh.new()
	box.size = Vector3(lebar_kotak, 0.4, panjang_kotak)
	papan.mesh = box
	papan.position = Vector3(0.0, -0.2, 0.0)

	var mat_papan := StandardMaterial3D.new()
	mat_papan.albedo_color = Color(\"#061024\")
	mat_papan.metallic = 0.8
	mat_papan.roughness = 0.25
	papan.material_override = mat_papan
	wadah.add_child(papan)
	if Engine.is_editor_hint():
		papan.owner = get_tree().edited_scene_root

	# 2. Grid sirkuit cyan & ungu/magenta di dalam kotak
	var mat_cyan := StandardMaterial3D.new()
	mat_cyan.albedo_color = Color(\"#00E5FF\")
	mat_cyan.emission_enabled = true
	mat_cyan.emission = Color(\"#00E5FF\")
	mat_cyan.emission_energy_multiplier = 1.4

	var mat_ungu := StandardMaterial3D.new()
	mat_ungu.albedo_color = Color(\"#D946EF\")
	mat_ungu.emission_enabled = true
	mat_ungu.emission = Color(\"#D946EF\")
	mat_ungu.emission_energy_multiplier = 1.3

	var jumlah_v := 7
	var jumlah_h := 5
	for i in range(jumlah_v):
		var px := lerpf(-hx + 2.2, hx - 2.2, float(i) / float(jumlah_v - 1))
		var garis_v := MeshInstance3D.new()
		var mesh_v := BoxMesh.new()
		mesh_v.size = Vector3(0.035, 0.012, panjang_kotak - 2.4)
		garis_v.mesh = mesh_v
		garis_v.position = Vector3(px, 0.006, 0.0)
		garis_v.material_override = mat_ungu if i % 3 == 1 else mat_cyan
		wadah.add_child(garis_v)
		if Engine.is_editor_hint():
			garis_v.owner = get_tree().edited_scene_root

	for j in range(jumlah_h):
		var pz := lerpf(-hz + 2.0, hz - 2.0, float(j) / float(jumlah_h - 1))
		var garis_h := MeshInstance3D.new()
		var mesh_h := BoxMesh.new()
		mesh_h.size = Vector3(lebar_kotak - 2.4, 0.012, 0.035)
		garis_h.mesh = mesh_h
		garis_h.position = Vector3(0.0, 0.006, pz)
		garis_h.material_override = mat_ungu if j % 2 == 1 else mat_cyan
		wadah.add_child(garis_h)
		if Engine.is_editor_hint():
			garis_h.owner = get_tree().edited_scene_root

	# 3. Kurva jalur di dalam kotak
	var jalur := Path3D.new()
	jalur.name = \"JalurDalamKotak\"
	var curve := Curve3D.new()
	curve.add_point(Vector3(-10.5, 0.0, 1.8),  Vector3.ZERO,        Vector3(2.2, 0.0, -2.2))
	curve.add_point(Vector3(-6.8,  0.0, -5.2), Vector3(-2.6, 0.0, 0.0),  Vector3(3.6, 0.0, 0.0))
	curve.add_point(Vector3(-2.8,  0.0, 0.2),  Vector3(0.4, 0.0, -3.4),  Vector3(-0.4, 0.0, 3.6))
	curve.add_point(Vector3(0.8,   0.0, 5.4),  Vector3(-2.8, 0.0, 0.0),  Vector3(2.8, 0.0, 0.0))
	curve.add_point(Vector3(4.6,   0.0, 0.6),  Vector3(-0.3, 0.0, 3.2),  Vector3(1.8, 0.0, -2.4))
	curve.add_point(Vector3(10.5,  0.0, -0.8), Vector3(-2.8, 0.0, 0.2),  Vector3.ZERO)
	jalur.curve = curve
	wadah.add_child(jalur)
	if Engine.is_editor_hint():
		jalur.owner = get_tree().edited_scene_root

	# 4. Lapisan bawah: bingkai neon lebar
	var neon_bawah := CSGPolygon3D.new()
	neon_bawah.name = \"NeonBawahJalur\"
	neon_bawah.polygon = PackedVector2Array([
		Vector2(-1.32, 0.015),
		Vector2(1.32, 0.015),
		Vector2(1.32, 0.065),
		Vector2(-1.32, 0.065)
	])
	neon_bawah.mode = CSGPolygon3D.MODE_PATH
	neon_bawah.path_node = neon_bawah.get_path_to(jalur)
	neon_bawah.path_interval_type = CSGPolygon3D.PATH_INTERVAL_DISTANCE
	neon_bawah.path_interval = 0.25
	neon_bawah.path_joined = false

	var mat_neon := StandardMaterial3D.new()
	mat_neon.albedo_color = Color(\"#00F0FF\")
	mat_neon.emission_enabled = true
	mat_neon.emission = Color(\"#00F0FF\")
	mat_neon.emission_energy_multiplier = 3.0
	neon_bawah.material = mat_neon
	wadah.add_child(neon_bawah)
	if Engine.is_editor_hint():
		neon_bawah.owner = get_tree().edited_scene_root

	# 5. Lapisan atas: badan jalan biru gelap
	var jalan_atas := CSGPolygon3D.new()
	jalan_atas.name = \"BadanJalanAtas\"
	jalan_atas.polygon = PackedVector2Array([
		Vector2(-1.12, 0.065),
		Vector2(1.12, 0.065),
		Vector2(1.12, 0.125),
		Vector2(-1.12, 0.125)
	])
	jalan_atas.mode = CSGPolygon3D.MODE_PATH
	jalan_atas.path_node = jalan_atas.get_path_to(jalur)
	jalan_atas.path_interval_type = CSGPolygon3D.PATH_INTERVAL_DISTANCE
	jalan_atas.path_interval = 0.25
	jalan_atas.path_joined = false

	var mat_jalan := StandardMaterial3D.new()
	mat_jalan.albedo_color = Color(\"#0D2B4C\")
	mat_jalan.metallic = 0.5
	mat_jalan.roughness = 0.35
	mat_jalan.emission_enabled = true
	mat_jalan.emission = Color(\"#08203A\")
	mat_jalan.emission_energy_multiplier = 0.35
	jalan_atas.material = mat_jalan
	wadah.add_child(jalan_atas)
	if Engine.is_editor_hint():
		jalan_atas.owner = get_tree().edited_scene_root
"

